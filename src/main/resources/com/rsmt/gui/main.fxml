<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rsmt.gui.SimulationController"
            styleClass="root-pane">

    <!-- ═══════════════════════  TOP BAR  ═══════════════════════ -->
    <top>
        <HBox styleClass="top-bar" spacing="16" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <Label text="rSMTv2" styleClass="title-label"/>
            <Label text="Reverse SMT Processor Simulator" styleClass="subtitle-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Cycle:" styleClass="stat-label"/>
            <Label fx:id="cycleCountLabel" text="0" styleClass="stat-value"/>
            <Label text="IPC:" styleClass="stat-label"/>
            <Label fx:id="ipcLabel" text="0.000" styleClass="stat-value"/>
            <Label fx:id="smtStatusLabel" text="rSMT ON" styleClass="smt-on-label"/>
        </HBox>
    </top>

    <!-- ═══════════════════════  LEFT PANEL — Controls  ═══════════════════════ -->
    <left>
        <VBox styleClass="config-panel" spacing="12" minWidth="220" maxWidth="220">
            <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>

            <Label text="SIMULATION CONFIG" styleClass="panel-header"/>
            <Separator/>

            <!-- Instruction count -->
            <Label text="Instructions" styleClass="param-label"/>
            <Spinner fx:id="numInstSpinner" editable="true" styleClass="param-spinner"/>

            <!-- rSMT delay -->
            <Label text="rSMT Delay (cycles)" styleClass="param-label"/>
            <Spinner fx:id="rSmtDelaySpinner" editable="true" styleClass="param-spinner"/>

            <Separator/>
            <Label text="rSMT PARAMS" styleClass="panel-header"/>
            <Separator/>

            <!-- rSMT availability -->
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label fx:id="labelRsmtAvail" styleClass="param-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="rSmtAvailLabel" styleClass="slider-value-label" minWidth="30"/>
            </HBox>
            <Slider fx:id="rSmtAvailSlider" min="0" max="100" value="60" showTickMarks="true"
                    showTickLabels="true" majorTickUnit="25" styleClass="param-slider"/>

            <!-- Data dependency -->
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label fx:id="labelRsmtDepends" styleClass="param-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="rSmtDependsLabel" styleClass="slider-value-label" minWidth="30"/>
            </HBox>
            <Slider fx:id="rSmtDependsSlider" min="0" max="100" value="20" showTickMarks="true"
                    showTickLabels="true" majorTickUnit="25" styleClass="param-slider"/>

            <Separator/>
            <Label text="ANIMATION SPEED" styleClass="panel-header"/>
            <ComboBox fx:id="speedCombo" styleClass="param-spinner"/>

            <Separator/>
            <Label text="CONTROLS" styleClass="panel-header"/>
            <ToggleButton fx:id="smtToggle" text="rSMT ON" selected="true" styleClass="smt-toggle"/>

            <HBox spacing="8">
                <Button fx:id="runButton"   text="▶  Run"   onAction="#onRun"   styleClass="run-button"   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="pauseButton" text="⏸ Pause" onAction="#onPause" styleClass="pause-button" HBox.hgrow="ALWAYS" maxWidth="Infinity" disable="true"/>
            </HBox>
            <Button fx:id="resetButton" text="⟳  Reset" onAction="#onReset" styleClass="reset-button" maxWidth="Infinity"/>

            <Separator/>
            <Label text="GAIN" styleClass="panel-header"/>
            <Label fx:id="gainLabel" text="—" styleClass="gain-label"/>

        </VBox>
    </left>

    <!-- ═══════════════════════  RIGHT PANEL — Mix sliders + Latency  ═══════════════════════ -->
    <right>
        <VBox styleClass="sliders-panel" spacing="8" minWidth="220" maxWidth="220">
            <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>

            <Label text="WORKLOAD MIX" styleClass="panel-header"/>
            <Label text="(sliders auto-adjust to sum to 100%)" styleClass="mix-hint-label"/>
            <Separator/>

            <!-- FXU mix -->
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label fx:id="labelPercentFxu" styleClass="param-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="percentFxuLabel" styleClass="slider-value-label" minWidth="30"/>
            </HBox>
            <Slider fx:id="percentFxuSlider" min="0" max="100" showTickMarks="true"
                    showTickLabels="true" majorTickUnit="25" styleClass="param-slider"/>

            <!-- FPU mix -->
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label fx:id="labelPercentFpu" styleClass="param-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="percentFpuLabel" styleClass="slider-value-label" minWidth="30"/>
            </HBox>
            <Slider fx:id="percentFpuSlider" min="0" max="100" showTickMarks="true"
                    showTickLabels="true" majorTickUnit="25" styleClass="param-slider"/>

            <!-- Branch mix -->
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label fx:id="labelPercentBranch" styleClass="param-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="percentBranchLabel" styleClass="slider-value-label" minWidth="30"/>
            </HBox>
            <Slider fx:id="percentBranchSlider" min="0" max="100" showTickMarks="true"
                    showTickLabels="true" majorTickUnit="25" styleClass="param-slider"/>

            <!-- LSU mix -->
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label fx:id="labelPercentLsu" styleClass="param-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="percentLsuLabel" styleClass="slider-value-label" minWidth="30"/>
            </HBox>
            <Slider fx:id="percentLsuSlider" min="0" max="100" showTickMarks="true"
                    showTickLabels="true" majorTickUnit="25" styleClass="param-slider"/>

            <!-- NOP remainder -->
            <Label fx:id="nopRemainderLabel" styleClass="nop-remainder-label"/>

            <Separator/>
            <Label text="LATENCY (cycles)" styleClass="panel-header"/>
            <Separator/>

            <!-- FXU latency -->
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="FXU cycles" styleClass="param-label" HBox.hgrow="ALWAYS"/>
                <Spinner fx:id="fxCyclesSpinner" editable="true" styleClass="param-spinner" minWidth="60" maxWidth="60"/>
            </HBox>

            <!-- FPU latency -->
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="FPU cycles" styleClass="param-label" HBox.hgrow="ALWAYS"/>
                <Spinner fx:id="fpCyclesSpinner" editable="true" styleClass="param-spinner" minWidth="60" maxWidth="60"/>
            </HBox>

            <!-- Branch latency -->
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="Branch cycles" styleClass="param-label" HBox.hgrow="ALWAYS"/>
                <Spinner fx:id="brCyclesSpinner" editable="true" styleClass="param-spinner" minWidth="60" maxWidth="60"/>
            </HBox>

            <!-- LSU latency -->
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="LSU cycles" styleClass="param-label" HBox.hgrow="ALWAYS"/>
                <Spinner fx:id="lsuCyclesSpinner" editable="true" styleClass="param-spinner" minWidth="60" maxWidth="60"/>
            </HBox>

        </VBox>
    </right>

    <!-- ═══════════════════════  CENTER — Pipeline grid  ═══════════════════════ -->
    <center>
        <VBox styleClass="pipeline-panel" spacing="0">
            <Label fx:id="pipelineHeaderLabel" styleClass="panel-header"
                   style="-fx-padding: 8 12 4 12;"/>
            <Separator/>
            <ScrollPane fx:id="pipelineScroll" fitToHeight="false" fitToWidth="false"
                        hbarPolicy="ALWAYS" vbarPolicy="AS_NEEDED" styleClass="pipeline-scroll"
                        VBox.vgrow="ALWAYS">
                <GridPane fx:id="pipelineGrid" styleClass="pipeline-grid" hgap="2" vgap="1">
                    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                </GridPane>
            </ScrollPane>

            <!-- Legend -->
            <HBox styleClass="stage-legend" spacing="12">
                <padding><Insets top="4" right="12" bottom="6" left="12"/></padding>
                <Label text="■ FXU" styleClass="legend-fxu"/>
                <Label text="■ FPU" styleClass="legend-fpu"/>
                <Label text="■ Branch" styleClass="legend-branch"/>
                <Label text="■ Load/Store" styleClass="legend-load"/>
                <Label text="■ NOP" styleClass="legend-nop"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="■ Structural" styleClass="legend-stall-struct"/>
                <Label text="■ Data" styleClass="legend-stall-data"/>
                <Label text="■ Control" styleClass="legend-stall-ctrl"/>
            </HBox>
        </VBox>
    </center>

    <!-- ═══════════════════════  BOTTOM — Analytics charts  ═══════════════════════ -->
    <bottom>
        <VBox styleClass="analytics-panel-bottom">
            <Separator/>
            <HBox spacing="0" prefHeight="200" minHeight="180" maxHeight="220">

                <!-- IPC over time -->
                <VBox styleClass="chart-pane" HBox.hgrow="ALWAYS" spacing="2">
                    <padding><Insets top="6" right="6" bottom="4" left="8"/></padding>
                    <Label text="IPC Over Time" styleClass="chart-label"/>
                    <LineChart fx:id="ipcChart" styleClass="rsmt-chart" animated="false"
                               createSymbols="false" legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis><NumberAxis label="" animated="false" forceZeroInRange="false"/></xAxis>
                        <yAxis><NumberAxis label="IPC" animated="false" forceZeroInRange="true" lowerBound="0"/></yAxis>
                    </LineChart>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <!-- Cycles: SMT-ON vs SMT-OFF -->
                <VBox styleClass="chart-pane" HBox.hgrow="ALWAYS" spacing="2">
                    <padding><Insets top="6" right="6" bottom="4" left="6"/></padding>
                    <Label text="Cycles: SMT-ON vs OFF" styleClass="chart-label"/>
                    <BarChart fx:id="cyclesChart" styleClass="rsmt-chart" animated="false"
                              legendVisible="true" VBox.vgrow="ALWAYS">
                        <xAxis><CategoryAxis animated="false"/></xAxis>
                        <yAxis><NumberAxis animated="false" forceZeroInRange="true" lowerBound="0"/></yAxis>
                    </BarChart>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <!-- Unit utilization -->
                <VBox styleClass="chart-pane" HBox.hgrow="ALWAYS" spacing="2">
                    <padding><Insets top="6" right="6" bottom="4" left="6"/></padding>
                    <Label text="Unit Utilization" styleClass="chart-label"/>
                    <BarChart fx:id="utilChart" styleClass="rsmt-chart" animated="false"
                              legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis><CategoryAxis animated="false"/></xAxis>
                        <yAxis><NumberAxis animated="false" forceZeroInRange="true" lowerBound="0" upperBound="100"/></yAxis>
                    </BarChart>
                </VBox>

                <Separator orientation="VERTICAL"/>

                <!-- Stall breakdown -->
                <VBox styleClass="chart-pane" HBox.hgrow="ALWAYS" spacing="2">
                    <padding><Insets top="6" right="8" bottom="4" left="6"/></padding>
                    <Label text="Stall Breakdown" styleClass="chart-label"/>
                    <BarChart fx:id="stallChart" styleClass="rsmt-chart" animated="false"
                              legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis><CategoryAxis animated="false"/></xAxis>
                        <yAxis><NumberAxis animated="false" forceZeroInRange="true" lowerBound="0"/></yAxis>
                    </BarChart>
                </VBox>

            </HBox>
        </VBox>
    </bottom>

</BorderPane>
